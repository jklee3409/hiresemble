VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://localhost:8080
# GitHub Source Gate 2를 로컬에서 사용할 때만 정확히 true로 설정한다.
VITE_GITHUB_SOURCE_ENABLED=true
# Private GitHub App UI는 실제 App 설정을 완료한 local에서만 true로 설정한다.
VITE_GITHUB_PRIVATE_ENABLED=false
# Career Artifact Gate 4를 로컬에서 사용할 때만 정확히 true로 설정한다.
VITE_CAREER_ARTIFACT_ENABLED=true
