# Docker Compose - PostgreSQL
POSTGRES_DB=hiresemble
POSTGRES_USER=hiresemble
POSTGRES_PASSWORD=hiresemble-local-password
POSTGRES_PORT=5432

# Backend datasource (JDBC URL)
DATABASE_URL=jdbc:postgresql://localhost:5432/hiresemble
DATABASE_USERNAME=hiresemble
DATABASE_PASSWORD=hiresemble-local-password
BACKEND_PORT=8080
SESSION_TIMEOUT=30m
SESSION_COOKIE_NAME=SESSION
SESSION_COOKIE_HTTP_ONLY=true
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax

# Idempotency HMAC (required for upload, manual-text, reparse, and retry mutations)
# The default local profile uses the safe development-only key bundled in application-local.yml.
# Replace this value and activate a non-local profile in deployed environments.
SPRING_PROFILES_ACTIVE=local
IDEMPOTENCY_HASH_KEY_VERSION=1
IDEMPOTENCY_HMAC_KEY=hiresemble-local-only-idempotency-key-change-in-production

# Docker Compose - MinIO / S3-compatible object storage
MINIO_ROOT_USER=hiresemble
MINIO_ROOT_PASSWORD=hiresemble-local-secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=hiresemble
OBJECT_STORAGE_SECRET_KEY=hiresemble-local-secret
OBJECT_STORAGE_BUCKET=hiresemble
OBJECT_STORAGE_REGION=us-east-1

# Document parser and deletion worker
DOCUMENT_PARSER_TIMEOUT=15s
DOCUMENT_PARSER_MAX_PAGES=500
DOCUMENT_PARSER_MAX_ZIP_ENTRIES=5000
DOCUMENT_PARSER_MAX_UNCOMPRESSED_BYTES=104857600
OBJECT_DELETION_SCAN_INTERVAL=30s
OBJECT_DELETION_LEASE_DURATION=2m
OBJECT_DELETION_BATCH_SIZE=20

# Job page fetch and deadline closing
JOB_PAGE_CONNECT_TIMEOUT=3s
JOB_PAGE_RESPONSE_TIMEOUT=10s
JOB_PAGE_MAX_REDIRECTS=5
JOB_PAGE_MAX_RESPONSE_BYTES=2097152
JOB_IMAGE_RESPONSE_TIMEOUT=15s
JOB_IMAGE_MAX_CANDIDATES=6
JOB_IMAGE_MAX_BYTES=5242880
JOB_IMAGE_MAX_TOTAL_BYTES=20971520
JOB_IMAGE_MAX_PIXELS=40000000
JOB_IMAGE_MIN_ITEM_MEANINGFUL_CHARACTERS=20
JOB_PAGE_MIN_DOM_CHARACTERS=600
JOB_MIN_DESCRIPTION_CHARACTERS=120
JOB_MAX_REPLACEMENT_RATIO=0.001
JOB_DEADLINE_SCHEDULER_CRON=0 0 * * * *
JOB_DEADLINE_SCHEDULER_BATCH_SIZE=100
JOB_AUTO_ANALYSIS_SCAN_INTERVAL=5s
JOB_AUTO_ANALYSIS_LEASE_DURATION=1m
JOB_AUTO_ANALYSIS_RETRY_DELAY=15s
JOB_AUTO_ANALYSIS_BATCH_SIZE=20
JOB_AUTO_ANALYSIS_MAX_ATTEMPTS=3

# Local uses real providers and fails startup when either key is absent.
# Use SPRING_PROFILES_ACTIVE=local-offline for a network-disabled backend.
AI_PROVIDER=openai
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_TIMEOUT=60s
AI_PROVIDER_MAX_RETRIES=0
AI_PROVIDER_STORE=false
ALLOW_INSECURE_PROVIDER_ENDPOINT=false
AI_CHAT_MODEL_PROVIDER=openai
AI_EMBEDDING_MODEL_PROVIDER=openai
AI_VECTOR_STORE_PROVIDER=none
AI_MODEL_LOW_COST=
AI_MODEL_BALANCED=gpt-5-mini
AI_MODEL_HIGH_QUALITY=
AI_EMBEDDING_MODEL=text-embedding-3-small

# Durable Agent Run worker runtime
AGENT_HEARTBEAT_INTERVAL=15s
AGENT_LEASE_DURATION=60s
AGENT_RECONCILIATION_INTERVAL=30s
AGENT_DISPATCH_INTERVAL=1s
AGENT_WORKER_THREADS=2
AGENT_QUEUE_CAPACITY=32
AGENT_RECONCILIATION_BATCH_SIZE=50
AGENT_WORKER_ID=local-worker

# External search is active in the local profile.
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
TAVILY_ENDPOINT=https://api.tavily.com/search

# Codex-only bounded live verification (excluded from check/CI/E2E).
CODEX_REAL_PROVIDER_TEST_ENABLED=false
CODEX_REAL_PROVIDER_TEST_MAX_COST_USD=0.050000
CODEX_REAL_PROVIDER_TEST_PRICE_VERSION=2026073101
CODEX_REAL_PROVIDER_TEST_CHAT_MAX_CALLS=1
CODEX_REAL_PROVIDER_TEST_EMBEDDING_MAX_CALLS=1
CODEX_REAL_PROVIDER_TEST_SEARCH_MAX_CALLS=1
CODEX_REAL_PROVIDER_TEST_TOTAL_MAX_CALLS=3
CODEX_REAL_PROVIDER_RETEST_MAX_TOTAL_CALLS=6

# Frontend / local mail testing
FRONTEND_ORIGIN=http://localhost:5173
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
